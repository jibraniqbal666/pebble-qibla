{
  "name": "pebble-qibla",
  "author": "MakeAwesomeHappen",
  "version": "2.11.0",
  "private": true,
  "keywords": [
    "pebble-app"
  ],
  "pebble": {
    "sdkVersion": "3",
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint"
    ],
    "enableMultiJS": true,
    "capabilities": [
      "location",
      "configurable"
    ],
    "projectType": "native",
    "displayName": "Qibla",
    "uuid": "0ab110ef-2e42-48c0-8f1d-cc9197a2d727",
    "watchapp": {
      "watchface": false,
      "hiddenApp": false,
      "onlyShownOnCommunication": false
    },
    "resources": {
      "media": [
        {
          "type": "png-trans",
          "name": "IMAGE_KAABA",
          "file": "images/kaaba.png"
        },
        {
          "type": "png",
          "name": "IMAGE_KAABA_MENUICON",
          "file": "images/kaaba_icon.png",
          "menuIcon": true
        }
      ]
    },
    "messageKeys": {
      "AM_GEO_LAT": 1,
      "AM_GEO_LON": 2,
      "AM_GEO_NAME": 3,
      "AM_CLEAR_CACHE": 4,
      "AM_ACK": 255
    }
  },
  "scripts": {
    "build": "pkts build"
  },
  "devDependencies": {
    "pkts": "^0.3.0-beta.1",
    "tsc": "^2.0.4",
    "typescript": "^5.9.3"
  }
}